# Copy this to .env.local and fill in the backend URL. (.env.local is gitignored.)

# Backend base URL — include the /ticketTriage suffix, no trailing slash.
# e.g. a Cloudflare tunnel: https://xxxx.trycloudflare.com/ticketTriage
NEXT_PUBLIC_API_URL=

# "true" = run entirely on in-repo mock data (no backend needed).
# "false" = hit the real backend (requires CORS + SameSite=None; Secure cookies).
NEXT_PUBLIC_USE_MOCK=false
