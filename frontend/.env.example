# Copy this to .env.local and adjust. (.env.local is gitignored.)

# Base URL of the PHP backend (no trailing slash, no /api prefix).
# Backend is exposed via a Cloudflare tunnel — update when the tunnel URL changes.
NEXT_PUBLIC_API_URL=

# "false" = hit the real backend via fetch(); anything else (or unset) = use the
# in-repo mock data layer so the frontend works with no backend running.
NEXT_PUBLIC_USE_MOCK=false
