# Copy this to .env.local and fill in BACKEND_ORIGIN. (.env.local is gitignored.)

# Backend base URL (server-side only). Include the /ticketTriage suffix.
# e.g. a Cloudflare tunnel: https://xxxx.trycloudflare.com/ticketTriage
BACKEND_ORIGIN=

# The browser calls this relative path; next.config.ts proxies it to BACKEND_ORIGIN
# (same-origin, so SameSite=Lax auth cookies work without CORS). Leave as /backend.
NEXT_PUBLIC_API_URL=/backend

# "true" = run entirely on in-repo mock data (no backend needed).
# "false" = hit the real backend through the proxy.
NEXT_PUBLIC_USE_MOCK=false
